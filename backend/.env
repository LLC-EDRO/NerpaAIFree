# Файл хранится в Git. Не добавляйте сюда ключи, пароли и внешние адреса.
# Локальная Gemma 4 через Ollama. Установите: ollama pull gemma4:12b
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_TEXT_MODEL=gemma4:12b
LOCAL_VISION_MODEL=gemma4:12b
# Локальная модель изображений; веса и сервер генерации устанавливаются отдельно.
LOCAL_IMAGE_MODEL=FLUX.2-klein-4B
PORT=4100
PRESENTATION_SANDBOX_IMAGE=nerpa-test-pptx:1
SLIDE_CONCURRENCY=2
PPTX_CONCURRENCY=2
