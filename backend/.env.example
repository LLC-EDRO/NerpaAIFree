LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-6-luna
OPENAI_TIMEOUT_MS=180000
# Optional text provider; visual analysis always uses the OpenAI vision settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Empty overrides use OPENAI_MODEL_MAIN for vision and web search.
# Reasoning policy: low normally/search, medium for complex repairs.
OPENAI_SEARCH_MODEL=
VISION_MODEL=
PORT=4100
PRESENTATION_SANDBOX_IMAGE=nerpa-test-pptx:1
# Independent AI slide workers and memory-heavy native PPTX processes.
SLIDE_CONCURRENCY=8
PPTX_CONCURRENCY=2
